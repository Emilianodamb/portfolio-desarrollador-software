---
import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioApp from '../components/PortfolioApp';
import { getImage } from 'astro:assets';
import portrait from '../assets/profile-hd.webp';
import { projects, otherProjects } from '../data/portfolio';
import type { ImageMetadata } from 'astro';
import type { ImageAssets, OptimizedImage } from '../context/ImageAssetsContext';

async function optimize(source: ImageMetadata, sizes: string): Promise<OptimizedImage> {
  const widths = [...new Set([320, 520, 800, Math.min(1040, source.width)].filter(width => width <= source.width))].sort((a, b) => a - b);
  const variants = await Promise.all(widths.map(width => getImage({ src: source, width, format: 'webp', quality: 82 })));
  const largest = variants[variants.length - 1];
  return {
    src: largest.src,
    srcSet: variants.map((variant, index) => `${variant.src} ${widths[index]}w`).join(', '),
    sizes,
    width: source.width,
    height: source.height,
  };
}

const hero = await optimize(portrait, '(max-width: 960px) 80vw, (max-width: 1625px) 32vw, 520px');
const projectImages = [...new Map([...projects, ...otherProjects].map(project => [project.image.src, project.image])).values()];
const images: ImageAssets = Object.fromEntries(await Promise.all(projectImages.map(async image => [image.src, await optimize(image, '(max-width: 960px) 80vw, 40vw')])));
images[portrait.src] = hero;
---
<BaseLayout hero={hero}>
  <PortfolioApp client:load images={images} />
</BaseLayout>
